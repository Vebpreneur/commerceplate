{
  "site": {
    "title": "Pawlira",
    "base_url": "https://pawlira.vercel.app/",
    "base_path": "/",
    "trailing_slash": false,
    "favicon": "/pawlira-icon.svg",
    "logo": "/images/pawlira-logo-black.svg",
    "logo_darkmode": "/images/pawlira-logo-white.svg",
    "logo_width": "184",
    "logo_height": "55",
    "logo_text": "Pawlira"
  },
  "announcement": {
    "enable": false,
    "content": "<span class='text-center block'>♥️ Loving Commerceplate? <a class='underline' href='https://github.com/zeon-studio/commerceplate' target='_blank' rel='noopener'>Please ⭐️ on Github</a></span>",
    "expire_days": 7
  },
  "settings": {
    "search": true,
    "account": true,
    "sticky_header": true,
    "theme_switcher": false,
    "default_theme": "light",
    "pagination_card": 9,
    "pagination_list": 4,
    "summary_length": 200,
    "blog_folder": "blog"
  },
  "params": {
    "contact_form_action": "#",
    "copyright": "© Pawlira"
  },
  "navigation_button": {
    "enable": false,
    "label": "Get Started",
    "link": "https://github.com/zeon-studio/commerceplate"
  },
  "google_tag_manager": {
    "enable": false,
    "gtm_id": "GTM-XXXXXX"
  },
  "metadata": {
    "meta_author": "Pawlira",
    "meta_image": "/images/hero.png",
    "meta_description": "Smarta produkter för ett enklare liv med katt."
  },
  "shopify": {
    "currencySymbol": "kr",
    "currencyCode": "SEK",
    "collections": {
      "hero_slider": "hidden-homepage-carousel",
      "featured_products": "featured-products"
    }
  }
}
